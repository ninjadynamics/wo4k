#include <windows.h>

#define WO_FILE_DESCRIPTION "WO4K Setup"
#define WO_INTERNAL_NAME "Setup"
#define WO_ORIGINAL_FILENAME "Setup.exe"
#define WO_FILE_TYPE VFT_APP
#include "version.rc"

